# The server reads these from its environment; nothing loads this file. On Railway set them under
# the service's Variables (docs/deploy-railway.md).

# Postgres for the supporters. Empty: they are kept in memory until the server stops.
# On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Where the server listens. Railway: 0.0.0.0 and the port its domain points at.
HOST=127.0.0.1
PORT=8765

# 1 behind one proxy (Railway's edge), so the rate limit sees each visitor's own address.
TRUST_PROXY=

# Files in S3, sent from CloudFront (docs/deploy-railway.md, File storage). Empty S3_BUCKET: off.
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are the arcade-server IAM user's key: set them
# only in Railway's Variables, never in a file.
S3_BUCKET=
AWS_REGION=
CLOUDFRONT_URL=

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "gate=\"$CLAUDE_PROJECT_DIR/tools/claude-hooks/commit-gate.js\"; if [ -f \"$gate\" ]; then node \"$gate\"; elif grep -qE '\"command\": *\"(([^\"\\\\]|\\\\.)*([^A-Za-z0-9_\\\\-]|\\\\[nt]))?git( +(-[cC] +[^ ]+|--?[A-Za-z-]+(=[^ ]*)?))* +(commit|revert|cherry-pick|am)([^A-Za-z0-9_-]|$)'; then echo 'This branch has no commit gate, so its commits would get no guideline review: merge the change that adds tools/claude-hooks/commit-gate.js into it first.' >&2; exit 2; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/claude-hooks/review-comments.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "guideline-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/claude-hooks/record-review.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
